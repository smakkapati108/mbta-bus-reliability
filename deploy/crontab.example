# Linux server alternative (crontab -e). Keep the collector itself under systemd (transit-collector.service).
*/15 * * * *  cd /opt/mbta && .venv/bin/python -m transit refresh >> data/logs/refresh.log 2>&1
15 4 * * *    cd /opt/mbta && .venv/bin/python -m transit gtfs && .venv/bin/python -m transit compact >> data/logs/nightly.log 2>&1
